---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
---

<BaseLayout title="Sermons - Andrew Shindyapin" description="Sermon outlines and Bible reading resources from Andrew Shindyapin.">
  <Header />
  <main class="w-full max-w-4xl mx-auto px-6 py-16 flex-1">
    <h1 class="text-3xl font-semibold mb-8">Sermons</h1>
    <ul>
      <li class="border-y border-gray-200 dark:border-gray-700 py-6">
        <a href="/sermons/ambient-bible-immersion/" class="text-xl font-semibold underline underline-offset-4 hover:text-gray-600 dark:hover:text-gray-300">
          Ambient Bible Immersion
        </a>
        <p lang="ru" class="mt-2 text-gray-600 dark:text-gray-400">Ежедневное погружение в Библию</p>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Romans 12:1-2</p>
      </li>
    </ul>
  </main>
  <Footer />
</BaseLayout>
